      <aliases enabled='yes' />
      <column caption='Cancellation Rate' datatype='real' default-format='p0.0%' name='[Calculation_1995657642953318400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([is_canceled])' />
      </column>
      <column caption='Paid ADR' datatype='real' name='[Calculation_1995657642953469953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [adr] &gt; 0 THEN [adr] END' />
      </column>
      <column caption='Revenue at Risk (High)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1995657642953605122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [risk_band] = &quot;High&quot;&#13;&#10;    THEN [revenue_at_stake]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Overall Cancellation Rate' datatype='real' name='[Calculation_1995657642953695235]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG([is_canceled]) }' />
      </column>
      <column caption='Gap vs Overall' datatype='real' name='[Calculation_1995657642954436612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([is_canceled]) -&#13;&#10;ATTR([Calculation_1995657642953695235])' />
      </column>
      <column caption='Avg Predicted Risk' datatype='real' name='[Calculation_1995657642954928133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([pred_cancel_prob])' />
      </column>
